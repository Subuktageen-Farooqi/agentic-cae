# Copy to .env for reference. The app reads process environment only; it does not
# automatically load .env. Set variables in your shell before running commands.
CAE_DATA_DIR=data
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_ID=gemini-3.8-flash
# Application Default Credentials: use gcloud auth application-default login.
# Optional ADC file override; never commit credentials or paste them into chat.
GOOGLE_APPLICATION_CREDENTIALS=
FREECAD_CMD=
CALCULIX_CCX=
GMSH_EXE=
CAE_CONTAINER_RUNTIME=docker
CAE_WORKER_TIMEOUT_SECONDS=300
CAE_CAD_IMAGE=agentic-cae-cad:2.6.1
