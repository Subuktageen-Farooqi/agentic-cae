# Copy to repository-root .env. Process environment values take precedence.
# Enter your AI Studio key locally; never paste it into chat or commit it.
LLM_PROVIDER=gemini_developer
GEMINI_API_KEY=
GEMINI_MODEL_ID=
# Suggested model verified in official docs 2026-10-27: gemini-3.5-flash-lite
# Optional Vertex mode: LLM_PROVIDER=vertex with local ADC and these settings.
CAE_DATA_DIR=data
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Application Default Credentials: use gcloud auth application-default login.
# Optional ADC file override; never commit credentials or paste them into chat.
GOOGLE_APPLICATION_CREDENTIALS=
FREECAD_CMD=
CALCULIX_CCX=
GMSH_EXE=
CAE_CONTAINER_RUNTIME=docker
CAE_WORKER_TIMEOUT_SECONDS=300
CAE_CAD_IMAGE=agentic-cae-cad:2.6.1
